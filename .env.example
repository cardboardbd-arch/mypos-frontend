# Base URL of the Laravel API this storefront reads from. Required.
NEXT_PUBLIC_API_URL=http://localhost/mypos/public/api

# This site's own public URL — used only by app/page.tsx (the homepage) to
# build its canonical/og:url tags (every other page's canonical comes
# pre-built from the Laravel API's own FRONTEND_URL-based value instead).
# Falls back to http://localhost:3000 if unset, which is fine for local
# dev but MUST be overridden to the real production domain on deploy —
# otherwise the live homepage's <link rel="canonical"> and og:url will
# point at localhost. (Phase 10.4T)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
